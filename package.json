		"pr-check": "prettier --check . && yarn lint",
		"license": "license-report --config=.license-report-rc.json > ./src/static/licenses/report.json"
	},
	"browserslist": [
		"defaults",
		"Android >= 4.3",
		"ios >= 8"
	],
	"author": "1000",
	"license": "MIT",
