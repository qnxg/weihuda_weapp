    "@tarojs/plugin-framework-react": "^4.1.1",
    "@tarojs/react": "^4.1.1",
    "@tarojs/runtime": "^4.1.1",
    "@tarojs/taro": "^4.1.1",
    "@tarojs/webpack5-runner": "^4.1.1",
    "classnames": "^2.3.2",
    "dayjs": "^1.11.10",
    "entities": "^4.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.1.3"
  },
