    "@tarojs/cli": "^4.1.1",
    "@tarojs/helper": "^4.1.7",
    "@tarojs/mini-runner": "^3.6.17",
    "@types/react": "^18.2.28",
    "@types/react-dom": "^19.1.9",
    "@types/sass": "=1.43.1",
    "@types/webpack-env": "^1.18.2",
    "autoprefixer": "^10.4.21",
    "babel-plugin-import": "^1.13.8",
    "babel-preset-taro": "^3.6.17",
    "eslint": "^9.27.0",
