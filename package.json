  "private": true,
  "description": "湖南大学微生活小程序",
  "type": "module",
  "templateInfo": {
    "typescript": true,
    "css": "sass"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "postinstall": "weapp-tw patch",
    "lint": "tsc --noEmit && eslint ./src --max-warnings 0",
    "fmt": "prettier --write . --log-level warn",
    "dev": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=true taro build --type weapp --watch",
    "build": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=true yarn lint && cross-env BROWSERSLIST_IGNORE_OLD_DATA=true taro build --type weapp",
    "pr-check": "prettier --check . && yarn lint"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "1000",
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "^7.23.1",
